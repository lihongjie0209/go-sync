{
  "source_type": "sqlserver_legacy",
  "source_id": "sqlserver-2000-client-01",
  "dsn": "${SQLSERVER_DSN}",
  "tables": [{"schema": "dbo", "name": "items"}],
  "data_dir": "data-sqlserver-legacy",
  "http_url": "http://127.0.0.1:8080/cdc",
  "http_headers": {"Authorization": "Bearer ${CDC_TOKEN}"},
  "metrics_addr": "127.0.0.1:9090",
  "sqlserver_legacy": {
    "auto_install": true,
    "allow_snapshot_locks": false,
    "owner": "dbo",
    "prefix": "go_sync_legacy",
    "poll_interval": "1s",
    "query_timeout": "5m",
    "snapshot_timeout": "1h"
  }
}
