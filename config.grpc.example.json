{
  "source_type": "postgres",
  "source_id": "pms-client-01",
  "dsn": "${SOURCE_DSN}",
  "slot": "pms_sync",
  "tables": [{"schema": "public", "name": "documents"}],
  "data_dir": "data",
  "transport": "grpc",
  "grpc": {
    "address": "sync.example.com:7443",
    "token": "${GO_SYNC_TOKEN}",
    "tls": {"ca_file": "ca.crt", "server_name": "sync.example.com"},
    "metrics_interval": "30s"
  },
  "replay": {"max_age": "168h", "max_bytes": 21474836480},
  "queue_bytes": 10737418240,
  "reserve_bytes": 268435456,
  "batch_rows": 500,
  "batch_bytes": 1048576,
  "max_row_bytes": 16777216,
  "http_timeout": "30s",
  "retry_min": "1s",
  "retry_max": "60s",
  "metrics_addr": "127.0.0.1:9090",
  "wal2json_auto_install": true,
  "postgres_bin_dir": "",
  "log": {"level": "info", "max_size_mb": 100, "max_backups": 10, "max_age_days": 30, "compress": true}
}
