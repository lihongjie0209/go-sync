{
  "source_id": "example",
  "dsn": "${GO_SYNC_DSN}",
  "slot": "go_sync_example",
  "tables": [{"schema":"public", "name":"items"}],
  "data_dir": "data",
  "log": {"file":"logs/go-sync.log", "level":"info", "max_size_mb":100, "max_backups":10, "max_age_days":30, "compress":true},
  "metrics_addr": "127.0.0.1:9108",
  "wal2json_auto_install": true,
  "postgres_bin_dir": "",
  "http_url": "http://127.0.0.1:8080/cdc",
  "http_headers": {"Authorization":"Bearer ${GO_SYNC_HTTP_TOKEN}"},
  "queue_bytes": 10737418240,
  "reserve_bytes": 268435456,
  "batch_rows": 500,
  "batch_bytes": 1048576,
  "max_row_bytes": 16777216,
  "http_timeout": "30s",
  "retry_min": "1s",
  "retry_max": "60s"
}
